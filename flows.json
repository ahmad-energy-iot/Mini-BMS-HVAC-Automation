        "id": "4c5ea41c0a2d1663",
        "type": "function",
        "z": "c97c20e2d707239e",
        "name": "Scale Temperature",
        "func": "let rawValue;\n\nif (Array.isArray(msg.payload)) {\n    rawValue = msg.payload[0];\n} else {\n    rawValue = msg.payload;\n}\n\nmsg.payload = Number(rawValue) / 10;\nmsg.topic = \"Temperature Istwert\";\n\nreturn msg;",
