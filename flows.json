    {
        "id": "d5464ba987e868ec",
        "type": "function",
        "z": "c97c20e2d707239e",
        "name": "Cooling Hysteresis",
        "func": "let temperature = msg.payload;\n\nlet setpoint = flow.get(\"setpoint\");\nlet coolingState = flow.get(\"coolingState\");\n\nif (setpoint === undefined) {\n    setpoint = 23;\n}\n\nif (coolingState === undefined) {\n    coolingState = false;\n}\n\nlet onThreshold = setpoint + 1;\nlet offThreshold = setpoint - 1;\n\nif (temperature >= onThreshold) {\n    coolingState = true;\n}\n\nif (temperature <= offThreshold) {\n    coolingState = false;\n}\n\nflow.set(\"coolingState\", coolingState);\n\nmsg.setpoint = setpoint;\nmsg.onThreshold = onThreshold;\nmsg.offThreshold = offThreshold;\nmsg.coolingDemand = coolingState;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 100,
        "wires": [
            [
                "935b0d679b3b1360"
            ]
        ]
    },
    {
        "id": "935b0d679b3b1360",
        "type": "function",
        "z": "c97c20e2d707239e",
        "name": "Fan Alarm Logic",
        "func": "let autoMode = flow.get(\"autoMode\");\nlet manualFanCommand = flow.get(\"manualFanCommand\");\nlet fanFeedback = flow.get(\"fanFeedback\");\n\nif (autoMode === undefined) {\n    autoMode = true;\n}\n\nif (manualFanCommand === undefined) {\n    manualFanCommand = false;\n}\n\nif (fanFeedback === undefined) {\n    fanFeedback = false;\n}\n\nif (autoMode === true) {\n    msg.fanCommand = msg.coolingDemand;\n    msg.operationMode = \"AUTO\";\n} else {\n    msg.fanCommand = manualFanCommand;\n    msg.operationMode = \"MANUAL\";\n}\n\nmsg.fanFeedback = fanFeedback;\n\nif (msg.fanCommand === true && msg.fanFeedback === false) {\n    msg.alarm = true;\n    msg.alarmText = \"Fan fault: Command ON but no feedback\";\n} else {\n    msg.alarm = false;\n    msg.alarmText = \"No alarm\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1080,
        "y": 100,
